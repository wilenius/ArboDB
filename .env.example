# Copy to .env and fill in. All variables are PUBLIC_ because this app talks to
# Supabase straight from the browser; row level security is what protects data.

# Local stack: the values printed by `npm run db:start`.
# Hosted: Project settings → API in the Supabase dashboard (use an EU region).
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=

# Maanmittauslaitos open data API key, for the aerial imagery and background map.
# Free, register at https://www.maanmittauslaitos.fi/rajapinnat/api-avaimen-ohje
# Without it the map falls back to OpenStreetMap plus any imported layers.
PUBLIC_MML_API_KEY=

# Where the map opens when nothing is positioned yet: the arboretum plot.
PUBLIC_MAP_CENTER_LAT=60.3308
PUBLIC_MAP_CENTER_LON=24.6641
PUBLIC_MAP_ZOOM=17
